{
  "name": "cla",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "docker run -d --name cla-api-test -p 8080:8080 -e GOOGLE_APPLICATION_CREDENTIALS=/app/key.json -v $(pwd)/serviceAccountKey.json:/app/key.json:ro cla-api && wait-on http://localhost:8080/api/licencas && cypress run && docker rm -f cla-api-test"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-file-system": "^56.0.7",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.13.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "wait-on": "^7.2.0"
  },
  "private": true
}
