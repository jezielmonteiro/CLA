{
  "expo": {
    "name": "CLA",
    "slug": "cla",
    "version": "26.04.1107",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#296959"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seuusuario.cla",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para mostrar as licenças ambientais próximas a você no mapa."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#296959"
      },
      "softwareKeyboardLayoutMode": "resize",
      "navigationBar": {
        "backgroundColor": "#ffffff",
        "barStyle": "dark-content"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.seuusuario.cla"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "369cdb11-ec78-49f9-a12f-e9dd351c0a78"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
